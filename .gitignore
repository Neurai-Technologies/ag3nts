# =============================================================================
# ag3nts — .gitignore
# Excludes binaries, credentials, caches, and runtime files.
# =============================================================================

# --- Tool binaries ---
*.exe
*.exe.old.*
macos/claude-code/bin/claude
macos/codex-cli/bin/codex
windows/claude-code/bin/

# --- Portable Node.js ---
windows/node/
macos/node/

# --- npm packages ---
**/node_modules/
package-lock.json

# --- npm-generated launcher stubs (keep only custom ones) ---
windows/gemini-cli/gemini
windows/gemini-cli/gemini.cmd
windows/gemini-cli/gemini.ps1
windows/codex-cli/codex.cmd
windows/codex-cli/package.json

# --- Auth & credentials (CRITICAL) ---
.credentials.json
auth.json
oauth_creds.json
google_accounts.json
installation_id
cap_sid
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Session data & caches ---
history.jsonl
stats-cache.json
models_cache.json
mcp-needs-auth-cache.json
state.json
version.json
.personality_migration
trustedFolders.json
projects.json

# --- Claude Code runtime ---
**/config/backups/
**/config/cache/
**/config/debug/
**/config/downloads/
**/config/file-history/
**/config/paste-cache/
**/config/plans/
**/config/plugins/
**/config/projects/
**/config/shell-snapshots/
**/config/telemetry/
**/config/todos/
**/config/tasks/
**/config/ide/

# --- Gemini CLI runtime ---
**/config/history/
**/config/tmp/
**/config/antigravity/

# --- Codex CLI runtime ---
**/config/log/
**/config/skills/
**/config/.sandbox/
**/config/.sandbox-bin/
**/config/.sandbox-secrets/
sandbox.log

# --- Synced copies (generated by launchers, not source of truth) ---
windows/claude-code/config/ag3nts.md
windows/claude-code/config/CLAUDE.md
windows/claude-code/config/settings.json
windows/gemini-cli/config/ag3nts.md
windows/gemini-cli/config/GEMINI.md
windows/gemini-cli/config/settings.json
windows/codex-cli/config/ag3nts.md
windows/codex-cli/config/AGENTS.md
windows/codex-cli/config/config.toml
macos/claude-code/config/ag3nts.md
macos/claude-code/config/CLAUDE.md
macos/claude-code/config/settings.json
macos/gemini-cli/config/ag3nts.md
macos/gemini-cli/config/GEMINI.md
macos/gemini-cli/config/settings.json
macos/codex-cli/config/ag3nts.md
macos/codex-cli/config/AGENTS.md
macos/codex-cli/config/config.toml

# --- Claude Code agents (synced from shared, not source of truth) ---
windows/claude-code/config/agents/
macos/claude-code/config/agents/

# --- Go build output ---
bin/ag3nts
dist/

# --- ag3nts runtime directories ---
tools/
config/ag3nts.toml
config/auth.toml
config/workflows/
config/claude/
config/codex/
config/gemini/
cache/
state/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editor ---
.vscode/
*.swp
*.swo
*~

# --- Codex session logs ---
**/config/sessions/
**/config/image-cache/
