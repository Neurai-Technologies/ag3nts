#!/bin/bash
# Auto-detect SSD, build combined AGENTS.md, launch Codex CLI.

# Search /Volumes and $HOME up to 5 levels deep for the ag3nts project
BASE_PATH=$(find /Volumes -maxdepth 5 -type d -name "ag3nts" -exec test -f "{}/shared/ag3nts.md" \; -print -quit 2>/dev/null)
if [ -z "$BASE_PATH" ]; then
    BASE_PATH=$(find "$HOME" -maxdepth 4 -type d -name "ag3nts" -exec test -f "{}/shared/ag3nts.md" \; -print -quit 2>/dev/null)
fi
if [ -z "$BASE_PATH" ]; then
    echo "Codex CLI not found. Is the SSD connected?"
    exit 1
fi

# Build combined AGENTS.md from ag3nts.md + stub
SHARED="$BASE_PATH/shared"
CONFIG="$BASE_PATH/macos/codex-cli/config"

cat "$SHARED/ag3nts.md" > "$CONFIG/AGENTS.md"
printf '\n---\n\n' >> "$CONFIG/AGENTS.md"
cat "$SHARED/codex-cli/AGENTS.md" >> "$CONFIG/AGENTS.md"

# Launch
exec "$BASE_PATH/macos/codex-cli/codex-launch.sh" "$@"
